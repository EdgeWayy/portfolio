# Payment details for the Payment section (src/data/payments.js).
# Copy this file to .env.local, replace the X placeholders, and run `npm run dev` / `npm run build`.
# .env.local is git-ignored. For the GitHub Pages build, add the same names as repository Variables:
#   Settings -> Secrets and variables -> Actions -> Variables
# A value left as XXXX (or empty) shows "details on Telegram" instead of a number.
# Everything here is printed on the public page: receiving details only, never a PIN, CVV or SMS code.

VITE_PAY_HOLDER=XXXX XXXX

# Optional default amount and currency (UZS, USD, RUB, KZT). Links like ?amount=1500000&cur=UZS#pay override it.
VITE_PAY_AMOUNT=
VITE_PAY_CURRENCY=UZS

# Payment pages (merchant or personal payment links)
VITE_PAY_CLICK_URL=https://my.click.uz/services/pay?XXXX
VITE_PAY_PAYME_URL=https://payme.uz/XXXX
VITE_PAY_UZUM_URL=https://uzumbank.uz/XXXX

# Cards inside Uzbekistan
VITE_PAY_UZCARD=8600 XXXX XXXX XXXX
VITE_PAY_HUMO=9860 XXXX XXXX XXXX

# From abroad. ABROAD_CARD: the Humo/Uzcard that receives transfers from Russia and Kazakhstan
# (falls back to HUMO, then UZCARD). RU/KZ URLs: optional transfer-service links.
VITE_PAY_ABROAD_CARD=9860 XXXX XXXX XXXX
VITE_PAY_RU_URL=
VITE_PAY_KZ_URL=

# International Visa/Mastercard: a Visa/Mastercard of an Uzbek bank, and/or a payment link that accepts foreign cards
VITE_PAY_VISA=4XXX XXXX XXXX XXXX
VITE_PAY_INTL_URL=
